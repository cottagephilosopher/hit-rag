# ==================== RAG 文档预处理系统环境配置模板 ====================
# 使用说明：
# 1. 复制此文件为 .env：cp env.template .env
# 2. 填写必要的配置项（特别是 API 密钥）
# 3. 根据实际情况调整路径和参数

# ==================== 路径配置 ====================
# 基础目录：项目根目录（默认：当前项目的父目录的父目录）
# 如果不配置，使用默认值
BASE_DIR=./

# 所有上传文件保存的目录
FILE_DIR=../files

# Markdown 文档目录：存放所有待处理的 .md 文件（默认：${BASE_DIR}/all-md）
ALL_MD_DIR=../all-md

# 输出目录：存放处理后的 JSON 文件（默认：${BASE_DIR}/rag-visualizer/public/output）
OUTPUT_DIR=../output

# 项目工作目录：当前项目目录（默认：当前文件所在目录）
IKN_PLUS_DIR=./

# 数据库文件路径：存储预处理元数据的 SQLite 数据库文件
# 本地开发使用相对路径，Docker 容器会覆盖为 /app/.dbs/rag_test.db
DB_FILE='.dbs/rag_preprocessor.db'

# ==================== 登录鉴权配置 ====================
# GitHub OAuth 配置
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
# OAuth 回调地址（后端 API 地址）
OAUTH_CALLBACK_BASE_URL=https://your-domain.com
# 用户名密码登录的密钥
UP_JWT_SECRET=your_jwt_secret_here
UP_JWT_EXPIRE_MINUTES=180

# ==================== 文档解析配置 ====================
# Mineru 服务地址
MINERU_API_BASE=https://mineru.net
MINERU_API_KEY=your_mineru_api_key_here

# 火山引擎 TOS 对象存储配置
TOS_OBS_ENDPOINT=tos-cn-beijing.volces.com
TOS_OBS_REGION=cn-beijing
TOS_OBS_BUCKET_NAME=your_bucket_name
TOS_OBS_ACCESS_URL=https://your-bucket.tos-cn-beijing.volces.com
VOLC_ACCESSKEY=your_volc_access_key_here
VOLC_SECRETKEY=your_volc_secret_key_here

# ==================== LLM 配置 ====================
# LLM 服务提供商：azure（Azure OpenAI）| openai（OpenAI 官方）| dashscope（阿里云灵积）
LLM_PROVIDER=dashscope

# Azure OpenAI 配置
# Azure OpenAI API 密钥
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# Azure OpenAI 服务端点地址
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Azure OpenAI 部署模型名称
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Azure OpenAI API 版本号
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI 配置（备用）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=claude-sonnet-4-20250514
OPENAI_API_BASE=https://api.openai.com/v1

# DashScope 配置（阿里云灵积，备用）
# LLM_PROVIDER=dashscope
DASHSCOPE_MODEL=qwen-plus

# LLM API 参数
# 温度参数：控制输出随机性（0.0-2.0，越小越确定）
LLM_TEMPERATURE=0.1
# 最大生成 Token 数量
LLM_MAX_TOKENS=4000
# API 请求超时时间（秒）
LLM_TIMEOUT=120
# API 请求失败最大重试次数
LLM_MAX_RETRIES=3
# 重试间隔时间（秒）
LLM_RETRY_DELAY=2

# ==================== Embedding 配置 ====================
# Embedding Provider: ollama（本地，推荐中文）| azure（云端）
EMBEDDING_PROVIDER=dashscope

# Ollama Embedding 配置
# Ollama 服务地址（兼容 OpenAI API 格式）
OLLAMA_BASE_URL=http://localhost:11433/v1
# Ollama 使用的 Embedding 模型
OLLAMA_EMBEDDING_MODEL=text-embedding-v4

# 阿里云灵积 DashScope 配置
# DashScope API 密钥
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DashScope Embedding 模型名称
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# Embedding 向量维度
DASHSCOPE_EMBEDDING_DIMENSIONS=2048
# Embedding 最大 Token 限制（DashScope text-embedding-v4 限制为 8192）
EMBEDDING_MAX_TOKENS=8192

# Azure OpenAI Embedding 配置（备用）
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ==================== 向量库 Milvus 配置 ====================
# Milvus 服务主机地址
MILVUS_HOST=127.0.0.1
# Milvus 服务端口
MILVUS_PORT=19530
# Milvus 集合名称
MILVUS_COLLECTION_NAME='rag_test'

# Milvus 索引配置
# 索引类型（HNSW：层次化可导航小世界图）
MILVUS_INDEX_TYPE=HNSW
# 距离度量类型（L2：欧氏距离）
MILVUS_METRIC_TYPE=L2
# HNSW 参数：每层连接数（影响召回率和索引大小）
MILVUS_HNSW_M=16
# HNSW 参数：构建时的动态候选列表大小（影响索引质量）
MILVUS_HNSW_EF_CONSTRUCTION=200
# 搜索时的动态候选列表大小（影响搜索精度和速度）
MILVUS_SEARCH_EF=64

# 向量化策略
# 向量化批处理大小
VECTOR_BATCH_SIZE=20
# 向量化失败最大重试次数
VECTOR_MAX_RETRIES=3
# 向量化重试间隔时间（秒）
VECTOR_RETRY_DELAY=2
# 是否自动向量化
VECTOR_AUTO_VECTORIZE=false
# 是否跳过已弃用的内容
VECTOR_SKIP_DEPRECATED=true
# 是否跳过已向量化的内容
VECTOR_SKIP_VECTORIZED=true
# 默认返回的 Top K 结果数量
VECTOR_DEFAULT_TOP_K=5

# ==================== Tokenizer 配置 ====================
# Tokenizer 类型和编码
# Tokenizer 类型：tiktoken（OpenAI 的分词器）
TOKENIZER_TYPE=tiktoken
# Tokenizer 编码名称：cl100k_base（GPT-4 使用的编码）
TOKENIZER_ENCODING_NAME=cl100k_base
# TikToken 版本号
TIKTOKEN_VERSION=0.5.2

# ==================== Chunk 切分配置 ====================
# 阶段1：粗切参数
# 中间切块最大字符数
MID_CHUNK_MAX_CHARS=4000
# 中间切块重叠字符数
MID_CHUNK_OVERLAP_CHARS=100

# 阶段3：最终切分 Token 限制
# 最终切块最小 Token 数
FINAL_MIN_TOKENS=300
# 最终切块目标 Token 数
FINAL_TARGET_TOKENS=900
# 最终切块最大 Token 数
FINAL_MAX_TOKENS=2000
# 最终切块硬性限制 Token 数
FINAL_HARD_LIMIT=4000
# 原子块最大 Token 数（不可再分）
ATOMIC_MAX_TOKENS=4000

# 语义完整性优先
# 是否优先保证语义完整性
SEMANTIC_INTEGRITY_PRIORITY=true
# 是否启用小块合并
ENABLE_SMALL_CHUNK_MERGE=true
# 小块阈值（Token 数）
SMALL_CHUNK_THRESHOLD=100
# 是否保留 Markdown 结构
PRESERVE_MARKDOWN_STRUCTURE=true

# ==================== 标签配置 ====================
# 内容标签数量
# 每个内容生成的标签数量
CONTENT_TAG_COUNT=5
# 标签语言
TAG_LANGUAGE=中文

# ==================== 日志配置 ====================
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=../logs/rag_preprocessor.log
# 是否记录 Token 详细信息
LOG_TOKEN_DETAILS=true
# 是否记录 LLM 请求详情
LOG_LLM_REQUESTS=true

# ==================== 输出配置 ====================
# OUTPUT_DIR 已在顶部路径配置中设置
# 是否保存中间结果
SAVE_INTERMEDIATE_RESULTS=true
# JSON 缩进空格数
JSON_INDENT=2

# ==================== 性能优化配置 ====================
# 批处理大小
BATCH_SIZE=5
# 是否启用异步处理
ENABLE_ASYNC=true
# 最大并发请求数
MAX_CONCURRENT_REQUESTS=3
# 是否启用缓存
ENABLE_CACHE=true
# 缓存过期时间（秒）
CACHE_TTL=3600

# ==================== 验证配置 ====================
# 是否检查 Token 溢出
CHECK_TOKEN_OVERFLOW=true
# 是否启用严格模式
STRICT_MODE=false
# 是否检查 Token 连续性
CHECK_TOKEN_CONTINUITY=true
# Token 间隔阈值
TOKEN_GAP_THRESHOLD=50
# 是否检查句子完整性
CHECK_SENTENCE_INTEGRITY=true
# 是否检查表格完整性
CHECK_TABLE_INTEGRITY=true
# 是否检查代码块完整性
CHECK_CODE_BLOCK_INTEGRITY=true

# ==================== 服务 URL 配置 ====================
# 后端 API 服务地址（FastAPI）
API_BASE_URL=http://localhost:8086
# 前端文档界面地址（hit-rag-ui，Vue）
FRONTEND_UI_URL=http://localhost:3001
# 聊天界面地址（versa-chat-view，Next.js）
CHAT_UI_URL=http://localhost:3000

# ==================== 对话配置 ====================
# 是否启用闲聊模式
ENABLE_CHAT_MODE=true
# 闲聊模式阈值（0.0-1.0，超过此值判定为闲聊）
CHAT_MODE_THRESHOLD=0.7

# 自动标签识别：是否在对话和 Agent 中自动识别并使用标签筛选
# true: 开启自动标签识别，LLM 会并行分析用户查询并自动添加标签筛选
# false: 关闭自动标签识别，只有用户手动指定标签时才使用筛选
ENABLE_AUTO_TAG_FILTER=true
# 自动标签识别的置信度阈值（0.0-1.0）
# 只有置信度高于此阈值时才应用标签筛选
AUTO_TAG_FILTER_THRESHOLD=0.5

# ==================== RAG Pipeline 阈值配置 ====================
# 置信度阈值：用于判断检索结果是否可信（0.0-1.0，默认：0.5）
# - 置信度 >= 阈值：认为检索结果可信，可以回答
# - 置信度 < 阈值：检索结果不可信，可能需要澄清或拒绝回答
RAG_CONFIDENCE_THRESHOLD=0.47

# 检索相关性阈值：用于判断检索结果是否相关
# Rerank 分数阈值（0.0-1.0，越大越严格，默认：0.2）
# - rerank 分数 >= 阈值：认为检索结果相关
# - rerank 分数 < 阈值：认为检索结果不相关，拒绝回答
RAG_RERANK_SCORE_THRESHOLD=0.16

# L2 距离阈值（默认：1.2）
# - L2 距离 <= 阈值：认为检索结果相关
# - L2 距离 > 阈值：认为检索结果不相关，拒绝回答
# 注意：L2 距离越小越相关，与 rerank 分数相反
RAG_L2_DISTANCE_THRESHOLD=1.2

# 检索质量判定阈值：用于判断检索结果是否足够好
# Rerank 良好分数（默认：0.2）
RAG_RERANK_GOOD_THRESHOLD=0.18
# Rerank 优秀分数（默认：0.3）
RAG_RERANK_EXCELLENT_THRESHOLD=0.3

# L2 距离良好阈值（默认：1.2）
RAG_L2_GOOD_THRESHOLD=1.2
# L2 距离优秀阈值（默认：1.0）
RAG_L2_EXCELLENT_THRESHOLD=1.0

# 检索数量配置
# 单实体检索数量（默认：3）
RAG_ENTITY_TOP_K=5
# 多实体检索后去重数量（默认：15）
RAG_MULTI_ENTITY_DEDUP_LIMIT=20
# 重排序后保留数量（默认：8）
RAG_RERANK_TOP_N=8
# 单查询检索数量（默认：8）
RAG_SINGLE_QUERY_TOP_K=8
# 文件源显示数量（默认：5）
RAG_FILES_DISPLAY_LIMIT=5

